# Copy to .env and adjust. Every setting is optional unless noted.

# ---- Database (used by docker compose) ----
POSTGRES_USER=zebra
POSTGRES_PASSWORD=change-me
POSTGRES_DB=zebra
# DATABASE_URL is built by docker-compose.yml; set it yourself when running outside compose:
# DATABASE_URL=postgresql+asyncpg://zebra:change-me@localhost:5432/zebra

# Image tag used by docker-compose.yml: latest (newest release), a version such as 1.2.3 / 1.2 / 1,
# or edge (the main branch)
ZEBRA_WEB_TAG=latest

# Port published on the host
APP_PORT=8000
# Proxies whose X-Forwarded-For / X-Forwarded-Proto headers are trusted (comma-separated IPs or
# CIDRs). The default * trusts every client, which is only right when the app is reachable through
# a reverse proxy alone; set it to your proxy's address otherwise.
# FORWARDED_ALLOW_IPS=*

# Public URL of the app (used for the OIDC redirect URI and secure cookies)
PUBLIC_URL=http://localhost:8000

# ---- Printer created on first start (optional; printers can be managed in the UI) ----
DEFAULT_PRINTER_HOST=
DEFAULT_PRINTER_NAME=Zebra ZD420t
DEFAULT_PRINTER_PORT=9100
DEFAULT_PRINTER_DPI=203
PRINTER_TIMEOUT=5
# TCP ports printers may use (comma-separated, ranges allowed). Loopback, link-local (cloud
# metadata) and other special addresses are always refused, so printers cannot reach other services.
PRINTER_ALLOWED_PORTS=6101,9100-9109
# Allow printers on 127.0.0.1 / ::1 (e.g. `make emulator` during local development)
PRINTER_ALLOW_LOOPBACK=false

# ---- Authentication with Authentik (OpenID Connect) ----
AUTH_ENABLED=false
# Required when AUTH_ENABLED=true: a long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=change-me
# The provider's issuer URL, e.g. https://auth.example.com/application/o/zebra-web/
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
# Comma-separated Authentik groups allowed to log in (empty = any authenticated user)
OIDC_ALLOWED_GROUPS=

# ---- API docs ----
# The external API is documented at /api/v1/docs. Set to true to also serve Swagger/ReDoc and the
# OpenAPI spec of the web UI's own (internal) API at /docs, /redoc and /openapi.json.
ENABLE_INTERNAL_DOCS=false

# ---- Mass printing ----
BATCH_CHUNK_SIZE=50
MAX_BATCH_ROWS=10000
MAX_UPLOAD_BYTES=5242880
